{
  "name": "arc-units",
  "version": "0.1.0",
  "description": "Correct USDC amount handling on Arc, where one balance is exposed through an 18-decimal native interface and a truncating 6-decimal ERC-20 interface",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "probe": "node scripts/probe.mjs",
    "verify": "npm run build && node scripts/verify-e2e.mjs",
    "build:web": "esbuild web/app.ts --bundle --minify --format=esm --target=es2022 --outfile=public/app.js && node scripts/copy-web.mjs"
  },
  "keywords": [
    "arc",
    "circle",
    "usdc",
    "stablecoin",
    "decimals",
    "viem",
    "evm"
  ],
  "license": "MIT",
  "author": "JspIIV",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JspIIV/arc-units.git"
  },
  "homepage": "https://github.com/JspIIV/arc-units#readme",
  "bugs": {
    "url": "https://github.com/JspIIV/arc-units/issues"
  },
  "peerDependencies": {
    "viem": "^2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "viem": "^2.55.10"
  }
}
